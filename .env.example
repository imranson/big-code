# Ollama cloud API key (https://ollama.com/settings/keys). Required to chat and use web tools.
OLLAMA_API_KEY=

# Where the Ollama SDK sends chat requests. Keep https://ollama.com to use the cloud API
# (web APIs only, no local Ollama server).
OLLAMA_HOST=https://ollama.com

# Default model used by the UI.
OLLAMA_MODEL=gpt-oss:120b

# Nominal context window (tokens) used for the rough context-usage estimate.
OLLAMA_CONTEXT_WINDOW=128000

# Directory that stores conversation JSON files (conversations/ and archive/).
DATA_DIR=data
